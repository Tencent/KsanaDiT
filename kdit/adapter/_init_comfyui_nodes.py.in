import sys
from pathlib import Path

_COMFY_PROJECT_ROOT = str(Path(__file__).resolve().parent.parent.parent)
if _COMFY_PROJECT_ROOT not in sys.path:
    sys.path.insert(0, _COMFY_PROJECT_ROOT)

try:
    from kdit.adapter.comfyui import NODE_CLASS_MAPPINGS, NODE_DISPLAY_NAME_MAPPINGS
except Exception as e:  # pylint: disable=broad-except
    print(f"[import error][kdit.adapter.comfyui]: {str(e)}")
    NODE_CLASS_MAPPINGS = {}
    NODE_DISPLAY_NAME_MAPPINGS = {}

__all__ = [
    "NODE_CLASS_MAPPINGS",
    "NODE_DISPLAY_NAME_MAPPINGS",
]
